# Bot Framework style tokens signed once, offline, with a key generated for these tests; nothing outside them trusts it.
# header-s1.json, header-k1.json and claims.json are written by hand (no trailing newline). The rest was produced in this
# directory with OpenSSL 3, by exactly these commands:
#
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out signing-key.pem
#   b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
#   openssl rsa -in signing-key.pem -noout -modulus | cut -d= -f2 | xxd -r -p | b64url > modulus
#   sign() { input="$(b64url < "$1").$(b64url < claims.json)"; printf '%s.%s' "$input" "$(printf '%s' "$input" | openssl dgst -sha256 -sign signing-key.pem | b64url)"; }
#   sign header-s1.json > token-s1
#   sign header-k1.json > token-k1
#
# token-k1 is signed by the same key as token-s1 but names `k1`, a key it was not signed with.
