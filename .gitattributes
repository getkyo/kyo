# Force LF line endings for all text files to ensure consistent behavior across platforms
* text=auto eol=lf

# FrameCrlfTest guards Frame derivation on CRLF sources; its working-tree line
# endings must stay CRLF on every platform (it is excluded from scalafmt for
# the same reason).
kyo-data/shared/src/test/scala/kyo/FrameCrlfTest.scala text eol=crlf

# Third-party data and test vectors checked in byte for byte (NIST's files end lines in CRLF): each
# file's SHA-256 is pinned in a MANIFEST that the build verifies, and line-ending normalization would
# change the bytes and fail that check.
kyo-email/data/** -text
**/src/test/vectors/** -text
