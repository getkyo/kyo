.bloop
.bsp
.claude/*
!.claude/skills/
.metals
project/target
project/project
project/.boot
project/.ivy
project/.sbtboot
.vscode
target
*.log
graal_dumps
.idea
metals.sbt
jmh-result.json
*.jfr
*.json
*.gpg
test-output
.DS_Store
.jvmopts
node_modules

# GraalVM native-image manifests are checked into module resources and ship in the jar; the
# global *.json ignore above would otherwise drop them. Plugin-generated manifests live under
# target/ (resourceManaged) and stay ignored via the target rule.
!**/src/main/resources/META-INF/native-image/**/*.json

# Third-party data and test vectors (Wycheproof and others) checked in byte for byte and pinned by SHA-256 in a
# MANIFEST beside them; some of it is JSON.
!kyo-email/data/**/*.json
!**/src/test/vectors/**/*.json

# Local analysis notes, never committed
analysis-*.md

# Doctest content-hash cache. Lives outside target/ so a clean does not destroy it (CI
# restores it before the build, and a clean would then wipe what was just restored).
.doctest-cache/

# Local development artifacts: design notes, review packages, benchmark output, agent tooling.
.dev/

# macOS Spotlight opt-out marker (local only)
.metadata_never_index
