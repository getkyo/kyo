# Links with no plugin: the shim compiles its stubs. Starting a topic refuses with LibraryNotFound, the error the JVM gives
# for a missing native, rather than a NULL from the first driver call.
> nativeLink
$ exec sh -c 'set -eu; bin=$(find target -type f -perm -u+x -name consumer | head -n1); [ -n "$bin" ] || { echo "no consumer binary under target/" >&2; exit 1; }; "$bin" > out.txt 2>&1 || { cat out.txt; exit 1; }; cat out.txt; grep -q "CONSUMER aeron=panic:LibraryNotFound" out.txt'
