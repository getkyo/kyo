> nativeLink
$ exec sh -c 'set -eu; bin=$(find target -type f -perm -u+x -name consumer | head -n1); [ -n "$bin" ] || { echo "no consumer binary under target/" >&2; exit 1; }; "$bin" | grep -q "CONSUMER production=ok"; if ls "$(dirname "$bin")"/libkyo_aeron.* > /dev/null 2>&1; then echo "a test-only library was staged beside the production binary" >&2; exit 1; fi'

