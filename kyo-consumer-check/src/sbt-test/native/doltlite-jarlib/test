# The DoltLite engine on Native through the library the published artifact carries: the query is answered
# rather than refused. Staged with its library beside it, then run again without it.
> nativeLink
$ exec sh -c 'set -eu; bin=$(find target -type f -perm -u+x -name consumer | head -n1); lib=$(find target/kyo-ffi/natives -name "libkyo_doltlite.*" | head -n1); rm -rf deploy; mkdir deploy; cp "$bin" "$lib" deploy/; here=$(pwd); cd /; "$here/deploy/consumer" > "$here/out.txt" 2>&1 || { cat "$here/out.txt"; exit 1; }; cat "$here/out.txt"; grep -q "CONSUMER doltlite=2" "$here/out.txt"'
$ exec sh -c 'set -eu; rm -f deploy/libkyo_doltlite.*; here=$(pwd); cd /; if "$here/deploy/consumer" > "$here/missing.txt" 2>&1; then echo "expected the program to fail without its library"; exit 1; fi; cat "$here/missing.txt"; grep -qi "libkyo_doltlite" "$here/missing.txt"'
