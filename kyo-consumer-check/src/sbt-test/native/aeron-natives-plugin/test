# The aeron-jarlib round trip, wired by kyo-natives-plugin instead of by hand: the plugin resolves the library out of
# the published artifact, links the binary against it, and stages it beside the binary. Run from an unrelated working
# directory, so the rpath is what resolves it, then run again without it to prove the dependency is real.
> kyoNativesReport
> nativeLink
$ exec sh -c 'set -eu; bin=$(find target -type f -perm -u+x -name consumer | head -n1); dir=$(dirname "$bin"); ls "$dir"/libkyo_aeron.* > /dev/null'
$ exec sh -c 'set -eu; bin=$(find target -type f -perm -u+x -name consumer | head -n1); here=$(pwd); cd /; "$here/$bin" > "$here/out.txt" 2>&1 || { cat "$here/out.txt"; exit 1; }; cat "$here/out.txt"; grep -q "CONSUMER aeron=roundtrip" "$here/out.txt"'
$ exec sh -c 'set -eu; bin=$(find target -type f -perm -u+x -name consumer | head -n1); rm -f "$(dirname "$bin")"/libkyo_aeron.*; here=$(pwd); cd /; if "$here/$bin" > "$here/missing.txt" 2>&1; then echo "expected the program to fail without its library"; exit 1; fi; cat "$here/missing.txt"; grep -qi "libkyo_aeron" "$here/missing.txt"'
