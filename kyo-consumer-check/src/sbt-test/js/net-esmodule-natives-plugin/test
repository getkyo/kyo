# The CommonJS fixture's round trips under ModuleKind.ESModule, where the loader's two global-`require` candidates
# are inert and only KYO_FFI_<ID>_PATH can find a library.
#
# Run directly rather than through `> run` for three reasons: the transport is process-lifetime and a program that
# never exits would hang sbt with nothing to report; the bound below separates a process that ends from one that
# cannot; and the same binary has to run a second time without the overrides, which `> run` cannot express.
> kyoNativesReport

# The overrides themselves, not their effect. `jsEnv` reaches only the Node processes sbt spawns, so a run launched
# from a shell sees them only if they are exported, and asserting them here is what distinguishes "the plugin set
# them" from "something else found the library".
> writeNodeEnv
$ exec sh -c 'set -eu; cat node-env.sh; grep -q "KYO_FFI_KYONET_BORINGSSL_PATH=" node-env.sh; grep -q "KYO_FFI_KYONET_POSIX_URING_PATH=" node-env.sh'
# Each one has to name a file that exists, since the loader honours the override only when it does.
$ exec sh -c 'set -eu; . ./node-env.sh; test -f "$KYO_FFI_KYONET_BORINGSSL_PATH"; test -f "$KYO_FFI_KYONET_POSIX_URING_PATH"'

> fastLinkJS
$ exec sh -c 'set -eu; test -f target/node_modules/koffi/package.json'

# With the overrides exported: the posix transport, both round trips.
$ exec sh -c 'set -eu; . ./node-env.sh; entry=$(find target -name "main.mjs" -path "*fastopt*" | head -n1); test -n "$entry"; node "$entry" > run.log 2>&1 & pid=$!; i=0; while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 120 ]; do sleep 1; i=$((i+1)); done; if kill -0 "$pid" 2>/dev/null; then kill -9 "$pid"; echo "the process was still alive after ${i}s with its transport open"; cat run.log; exit 1; fi; wait "$pid" || { cat run.log; exit 1; }; echo "exited after ${i}s"'
$ exec sh -c 'cat run.log; grep -q "CONSUMER transport=PosixTransport plain=hello tls=hello" run.log'

# The negative control, and the assertion that actually pins the claim. The same binary with the overrides unset
# must fall to the JS floor: under ESModule there is no global `require` for the package lookup or the koffi probe
# to use, so nothing else can find the library. A run that still reports PosixTransport here would mean the
# override is not what carries this module kind, and the plugin is contributing nothing.
$ exec sh -c 'set -eu; entry=$(find target -name "main.mjs" -path "*fastopt*" | head -n1); env -u KYO_FFI_KYONET_BORINGSSL_PATH -u KYO_FFI_KYONET_POSIX_URING_PATH node "$entry" > floor.log 2>&1 & pid=$!; i=0; while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 120 ]; do sleep 1; i=$((i+1)); done; if kill -0 "$pid" 2>/dev/null; then kill -9 "$pid"; fi; cat floor.log; grep -q "CONSUMER transport=JsTransport" floor.log'
