# The engine reaches Node through the package `NativeLoader.jsResolve` asks `require.resolve` for, so Node is the judge
# of the path rather than a stat this test could write itself: it resolves the exact specifier from the linked output's
# directory, the way the application does. Then the query is answered rather than refused, which is what says the
# library koffi opened is the real engine.
> kyoNativesReport
> fastLinkJS
$ exec sh -c 'set -eu; test -f target/node_modules/koffi/package.json'
# The os is derived the way `NativeLoader.detectOsWith` derives it, musl included: process.platform says linux for
# both libcs, and a glibc library does not open under musl, so asking for the wrong pole here would report a miss
# that is this test's rather than the delivery's. The specifier is resolved from the linked output's own directory,
# which is where the application resolves it from.
$ exec node -e "const path=require('path'),fs=require('fs');const musl=fs.existsSync('/lib/ld-musl-x86_64.so.1')||fs.existsSync('/lib/ld-musl-aarch64.so.1');const os=process.platform==='darwin'?'darwin':process.platform==='win32'?'windows':(musl?'linux-musl':'linux');const arch=process.arch==='x64'?'x86_64':process.arch==='arm64'?'aarch64':process.arch;const ext=os==='darwin'?'dylib':os==='windows'?'dll':'so';const dirs=fs.readdirSync('target').filter(d=>d.startsWith('scala-'));if(dirs.length!==1)throw new Error('expected one scala- output directory, found '+dirs.join(', '));const out=fs.readdirSync(path.join('target',dirs[0])).filter(d=>d.endsWith('-fastopt'));if(out.length!==1)throw new Error('expected one -fastopt directory, found '+out.join(', '));const anchor=path.resolve('target',dirs[0],out[0],'main.js');const spec='@kyo/ffi-native/native/'+os+'-'+arch+'/libkyo_doltlite.'+ext;const r=require('module').createRequire(anchor);console.log('resolved',r.resolve(spec));"
