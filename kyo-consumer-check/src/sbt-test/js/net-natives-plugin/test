$ exec node -e "const path=require('path'),fs=require('fs');const os=process.platform==='darwin'?'darwin':process.platform==='win32'?'windows':'linux';const arch=process.arch==='x64'?'x86_64':process.arch==='arm64'?'aarch64':process.arch;const ext=os==='darwin'?'dylib':os==='windows'?'dll':'so';const out=fs.readdirSync('target').find(d=>d.startsWith('scala-'));const dir=path.resolve('target',out);const spec='@kyo/ffi-native/native/'+os+'-'+arch+'/libkyonet_boringssl.'+ext;const r=require('module').createRequire(path.join(dir,'x.js'));console.log('resolved',r.resolve(spec));"
